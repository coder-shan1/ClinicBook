# =====================================================================
# ClinicBook backend environment template
# =====================================================================
# Local use:   cp .env.sample .env
#              (Spring imports .env automatically when running from backend/;
#               a missing .env is ignored)
#
# Render use:  Do NOT upload this file. Add the keys below under
#              Dashboard -> your service -> Environment (or deploy render.yaml).
#
# !!! Never commit a real .env. Every value below is a placeholder. !!!
#
# NOTE: an imported .env cannot activate a Spring profile. For local runs set
# SPRING_PROFILES_ACTIVE=local in your shell (docker-compose does it for you).
# =====================================================================

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
# local | prod  (prod = Neon PostgreSQL; Render sets this in render.yaml)
SPRING_PROFILES_ACTIVE=local
# Render injects PORT automatically. SERVER_PORT overrides it if you set both.
SERVER_PORT=8080
# JVM flags for the container image (Render/Docker only).
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# ---------------------------------------------------------------------
# Neon PostgreSQL - production profile (DB_*)
# ---------------------------------------------------------------------
# Use the Neon "Connection string" -> JDBC form. Recommended direct host
# (without "-pooler") so Flyway and Hibernate prepared statements behave.
#   jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channelBinding=require
# If you must use the PgBouncer pooled host, append &prepareThreshold=0.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require&channelBinding=require
DB_USER=<neon-user>
DB_PASSWORD=<neon-password>
# Neon free tier auto-suspends; keep the pool small and let Hikari keep it warm.
DB_POOL_SIZE=5
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_KEEPALIVE_TIME_MS=300000

# ---------------------------------------------------------------------
# Local MySQL - local profile (CLINICBOOK_DB_*)
# Namespaced so unrelated DB_* variables on the machine cannot break local runs.
# ---------------------------------------------------------------------
CLINICBOOK_DB_URL=jdbc:mysql://localhost:3306/clinicbook?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CLINICBOOK_DB_USER=clinicbook
CLINICBOOK_DB_PASSWORD=clinicbook_dev_password

# docker-compose only (local MySQL container)
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=clinicbook
MYSQL_USER=clinicbook
MYSQL_PASSWORD=clinicbook_dev_password
DB_PORT=3306

# ---------------------------------------------------------------------
# JWT - required in every profile, no default value
# Generate: openssl rand -base64 48   (must be >= 32 bytes)
# Leave as CHANGE_ME until you do: the app refuses to start with a short secret.
# ---------------------------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_ISSUER=clinicbook
# Spring duration syntax: 15m / 7d, or ISO-8601 PT15M / P7D
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ---------------------------------------------------------------------
# CORS - required in prod, comma separated, no trailing slash
# ---------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# Login rate limiting
# ---------------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=1m

# ---------------------------------------------------------------------
# Clinic, scheduling and booking rules
# ---------------------------------------------------------------------
CLINIC_TIME_ZONE=Asia/Kolkata
SLOT_HORIZON_DAYS=30
SLOT_NIGHTLY_CRON=0 0 3 * * *
BOOKING_CANCEL_CUTOFF=2h
BOOKING_MAX_ACTIVE_PER_PATIENT=3

# ---------------------------------------------------------------------
# Mail / SMTP
# Local: Mailpit on localhost:1025 (web inbox http://localhost:8025)
# Production: Resend/Brevo/SES/Postmark SMTP credentials, or keep
# NOTIFICATIONS_ENABLED=false until mail is configured.
# Port 587 -> MAIL_STARTTLS=true, MAIL_SSL_ENABLE=false
# Port 465 -> MAIL_STARTTLS=false, MAIL_SSL_ENABLE=true
# ---------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL_ENABLE=false
MAIL_FROM=no-reply@clinicbook.local

# ---------------------------------------------------------------------
# Appointment notifications
# ---------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
CLINIC_NAME=ClinicBook
REMINDER_CRON=0 0 * * * *
REMINDER_LEAD=24h

# ---------------------------------------------------------------------
# Local demo seed data (local profile only)
# Demo doctors are skipped when DEMO_DOCTOR_PASSWORD is blank.
# ---------------------------------------------------------------------
SEED_ENABLED=true
DEMO_DOCTOR_PASSWORD=Doctor123!

# ---------------------------------------------------------------------
# Frontend (Vite reads this at build time, not runtime)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------
# Render deploy hook - GitHub Actions repository secret, NOT an app env var
# Add as: Settings -> Secrets and variables -> Actions -> RENDER_BACKEND_HOOK
# ---------------------------------------------------------------------
# RENDER_BACKEND_HOOK=https://api.render.com/deploy/srv-xxxxxxxx?key=xxxxxxxx
