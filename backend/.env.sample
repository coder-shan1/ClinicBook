# ClinicBook environment variables
# Copy to .env for local development:  cp .env.example .env
# Every value below is a DUMMY for local use only.
# Never put real secrets in this file. Production values are set in the Render dashboard.

# ---------------------------------------------------------------
# App / Spring
# ---------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------------------------------------------------------------
# Database (local MySQL)
# Production (Neon PostgreSQL) uses a different JDBC URL, e.g.
#   jdbc:postgresql://<neon-host>/<db>?sslmode=require
# ---------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/clinicbook?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=clinicbook
DB_PASSWORD=clinicbook_dev_password

# Used by docker-compose to create the local MySQL container
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=clinicbook
MYSQL_USER=clinicbook
MYSQL_PASSWORD=clinicbook_dev_password

# ---------------------------------------------------------------
# JWT
# JWT_SECRET must be at least 32 bytes. Generate a real one for any shared
# or deployed environment:   openssl rand -base64 48
# TTL values use ISO-8601 durations: PT15M = 15 minutes, P7D = 7 days.
# ---------------------------------------------------------------
JWT_SECRET=dev-only-dummy-jwt-secret-change-me-0123456789abcdef0123456789ab
JWT_ISSUER=clinicbook-local
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# ---------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins (no trailing slash).
# ---------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# Login rate limiting
# Max failed attempts allowed per window (per IP/email), window is an ISO-8601 duration.
# Loose values for local testing; tighten in production (e.g. 5 attempts per PT15M).
# ---------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=PT1M

# ---------------------------------------------------------------
# Mail (local Mailpit: SMTP on 1025, web inbox on http://localhost:8025)
# ---------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@clinicbook.local

# ---------------------------------------------------------------
# Frontend (Vite, read at build/dev time)
# ---------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1