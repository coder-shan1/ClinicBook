# ClinicBook docker-compose environment (copy to .env)
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=clinicbook
MYSQL_USER=clinicbook
MYSQL_PASSWORD=clinicbook_dev_password
DB_PORT=3306
JWT_SECRET=dev-only-clinicbook-secret-change-me-0123456789abcdef0123456789abcdef
NOTIFICATIONS_ENABLED=true
SEED_ENABLED=true
BACKEND_PORT=8080
FRONTEND_PORT=80
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025