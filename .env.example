# ClinicBook docker-compose environment (copy to .env)
# Local development only. Production/Render values live in backend/.env.sample
# and render.yaml; never reuse these dummy values outside local development.

SPRING_PROFILES_ACTIVE=local

# Local MySQL container
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=clinicbook
MYSQL_USER=clinicbook
MYSQL_PASSWORD=clinicbook_dev_password
DB_PORT=3306

# JWT (dummy local key, >= 32 bytes)
JWT_SECRET=dev-only-clinicbook-secret-change-me-0123456789abcdef0123456789abcdef

# Local demo doctors are skipped when this is blank
DEMO_DOCTOR_PASSWORD=Doctor123!

NOTIFICATIONS_ENABLED=true
SEED_ENABLED=true

BACKEND_PORT=8080
FRONTEND_PORT=80
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
