# ClinicBook frontend environment variables. Copy to .env and adjust.
# Only VITE_-prefixed vars are bundled into the app (read via import.meta.env).

# Base URL of the backend API used by src/api/client.ts.
# - Local dev: keep this COMMENTED to use '/api/v1' (relative). The Vite dev server
#   proxies /api -> http://localhost:8080 (vite.config.ts), so no CORS is needed
#   (the Phase 0 backend has not configured CORS yet).
# - Production: uncomment and set the absolute backend URL. The backend must allow
#   the frontend origin via CORS (ARCHITECTURE.md §8).
# VITE_API_URL=https://api.clinicbook.app/api/v1

# Mocking toggle. 'enabled' (default) serves mock data via MSW; 'disabled' calls the
# real backend. The Phase 0 backend has no endpoints yet, so leave this enabled.
VITE_API_MOCKING=enabled
