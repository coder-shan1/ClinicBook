# Base URL of the backend API. Used by the API client (src/api/client.ts).
# In dev with mocking enabled this is only used as a fallback.
VITE_API_URL=http://localhost:8080/api/v1

# Set to "disabled" to use the real backend instead of MSW mock data.
# When unset, mocking is enabled (default for Phase 0 — no backend yet).
VITE_API_MOCKING=enabled
